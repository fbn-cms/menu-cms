# Copy to .env.local for `next dev`. Never commit real values.
# The single source of truth for absolute URLs (QR, OG, canonical, JSON-LD). Never hardcode a host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must never appear in client bundles (build assertion enforces this).
SUPABASE_SERVICE_ROLE_KEY=
