# Copy to .env.development.local for `next dev` (NOT .env.local: production builds would
# bake it into the Worker). Never commit real values.
# The single source of truth for absolute URLs (QR, OG, canonical, JSON-LD). Never hardcode a host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RESTAURANT_SLUG=demo-bistro
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase "publishable" key (replaces the legacy anon key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase "secret" key (replaces the legacy service_role key). SERVER ONLY — never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Local/e2e only: canned AI text instead of Workers AI.
AI_FAKE=1
