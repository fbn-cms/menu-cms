// Cloudflare Worker config. Top level = local dev/preview; `env.demo` and `env.production`
// are the two deployed environments. Bindings are NOT inherited by envs, so each env
// repeats them. Resource IDs below are not secrets; the API token lives in .env.cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-local",
  "account_id": "5681c6743fb9bf1f3bbe0aa32faffd3b",
  // worker.ts = the OpenNext app + the hourly scheduled() handler.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Workers AI (free 10,000 neurons/day) powers "Write with AI" / "Translate" in the CMS.
  // Bound only in demo/production below: it has no local emulator and would force a remote
  // session for every local run. Locally, AI_FAKE=1 (.env.local) returns canned text.
  // SUPABASE_URL: for the cron (it runs outside Next, so NEXT_PUBLIC_* isn't inlined there).
  "vars": {
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SUPABASE_URL": "http://127.0.0.1:54321",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "menu-local" }],
  "r2_buckets": [
    { "binding": "MENU_BUCKET", "bucket_name": "menu-local-images" },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "menu-local-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "menu-local-tags",
      "database_id": "local",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],

  "env": {
    "demo": {
      "name": "menu-demo",
      // Workers Paid plan (since 2026-10-14). Cap CPU per request well above real use (≤ ~350 ms
      // for a full render) so a runaway bug fails fast instead of running up CPU time.
      "limits": { "cpu_ms": 5000 },
      "ai": { "binding": "AI" },
      "vars": {
        "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "SUPABASE_URL": "https://xnzzyoqofliwhpmzegps.supabase.co",
      },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "menu-demo" },
      ],
      "r2_buckets": [
        { "binding": "MENU_BUCKET", "bucket_name": "menu-demo-images" },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "menu-demo-cache",
        },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "menu-demo-tags",
          "database_id": "6f737d7e-eaf1-4c80-820f-1c8b2de54d8c",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
        ],
      },
      // One hourly trigger per Worker; worker.ts scheduled(): availability expiry every hour, photo cleanup at 03:00.
      // (Free plan: 5 cron triggers per account.)
      "triggers": { "crons": ["0 * * * *"] },
    },
    "production": {
      "name": "menu-prod",
      // Workers Paid plan (since 2026-10-14). Cap CPU per request well above real use (≤ ~350 ms
      // for a full render) so a runaway bug fails fast instead of running up CPU time.
      "limits": { "cpu_ms": 5000 },
      "ai": { "binding": "AI" },
      "vars": {
        "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "SUPABASE_URL": "https://jbmdnogghrykaelymnny.supabase.co",
        "CANONICAL_HOST": "flavoursbynajla.app",
      },
      // The live address (www. 301s to CANONICAL_HOST). workers.dev stays on, unredirected, as a test address.
      "routes": [
        { "pattern": "flavoursbynajla.app", "custom_domain": true },
        { "pattern": "www.flavoursbynajla.app", "custom_domain": true },
      ],
      "workers_dev": true,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "menu-prod" },
      ],
      "r2_buckets": [
        { "binding": "MENU_BUCKET", "bucket_name": "menu-prod-images" },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "menu-prod-cache",
        },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "menu-prod-tags",
          "database_id": "336ce3d9-a1ed-40db-879b-20fb234716b1",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
        ],
      },
      "triggers": { "crons": ["0 * * * *"] },
    },
  },
}
